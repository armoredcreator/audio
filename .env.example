# Copy into an isolated workspace only. No operational credentials belong here.
ARMORED_REAL_TELEGRAM=0
ARMORED_HUB_DRY_RUN=1
ARMORED_IA_PROVIDER=ollama
ARMORED_IA_OLLAMA_URL=http://localhost:11434
ARMORED_IA_OLLAMA_MODEL=gemma3:1b
ARMORED_IA_OLLAMA_TIMEOUT=90
ARMORED_IA_OLLAMA_MAX_TOKENS=256
ARMORED_IA_OLLAMA_TEMPERATURE=0.2
ARMORED_IA_OLLAMA_MAX_ATTEMPTS=1
ARMORED_IA_MAX_CANDIDATES=1
ARMORED_IA_MAX_ATTEMPTS=3
ARMORED_IA_POLICY_RETRIES=1
ARMORED_IA_AUTO_TRANSIENT_RETRIES=1
# Gemini is optional: explicitly set ARMORED_IA_PROVIDER=gemini to select it.
# Supply its key only through the existing private credential mechanism.

# For the real Telegram Coordinator, configure exactly three source/destination pairs.
# Keep credentials in credentials/project.env; do not commit credentials.
# ARMORED_REAL_TELEGRAM=1
# ARMORED_REQUIRED_SOURCE_COUNT=3
# TELEGRAM_API_ID=<your Telegram API ID>
# TELEGRAM_API_HASH=<your Telegram API hash>
# ARMORED_SOURCE_1_CHAT_ID=<source chat 1>
# ARMORED_SOURCE_1_ID=<stable source id 1>
# ARMORED_HUB_1_CHAT_ID=<destination chat 1>
# ARMORED_HUB_1_TOPIC_ID=<destination topic 1>
# Repeat SOURCE_2/HUB_2 and SOURCE_3/HUB_3 with distinct routes.
# The executable validates routes without contacting Telegram; real Hub sends
# require the explicit --publish command-line switch.
